# Copy to .env (never commit .env). All values optional for local dev.
PORT=8000
DATA_DIR=./data_runtime
# 1 = refuse to start if ml.api cannot be imported (set in production / demo)
REQUIRE_REAL_ML=0
# 1 = force stub even if ml.api is importable (tests only)
ML_FORCE_STUB=0
ADMIN_TOKEN=
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_IP_PER_MIN=120
MAX_UPLOAD_MB=8
# portfolio photos served at /api/asset/ (default: <repo>/ml/assets)
ML_ASSETS_DIR=
# OpenAI-compatible LLM for /api/draft_report (prototype: external; production: local vLLM/Ollama)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=30
# USD per 1M tokens; leave empty if unknown -> cost_usd is null (never guessed)
LLM_PRICE_IN_PER_1M=
LLM_PRICE_OUT_PER_1M=
# OpenAI-compatible reasoning_effort (Gemini: none|minimal|low|medium|high); empty = parameter not sent (e.g. a local server without it)
LLM_REASONING_EFFORT=minimal
